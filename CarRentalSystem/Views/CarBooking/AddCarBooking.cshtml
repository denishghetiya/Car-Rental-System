@model CarRentalSystem.ViewModels.CarBookingDetailViewModel

<div class="row">
    <div class="col">
        <form id="addCarBookingForm" class="p-3">
            <input type="hidden" asp-for="CarBookingId" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="CarIdH" />

            <div class="col-md-3">
                <label asp-for="CarIdD" class="form-label">Select Car</label>
                <select class="form-select CarIdD" asp-for="CarIdD"></select>
            </div>

            <div class="col-md-3">
                <label asp-for="StartDate" class="form-label">StartDate</label>
                <input asp-for="StartDate" type="date" class="form-control"  />
            </div>
            <div class="col-md-3">
                <label asp-for="EndDate" class="form-label">EndDate</label>
                <input asp-for="EndDate" type="date" class="form-control"  />
            </div>

            <div class="col-md-3">
                <label asp-for="PricePerDay" class="form-label">PricePerDay</label>
                <input asp-for="PricePerDay" type="number" class="form-control priceperdayD" readonly/>
            </div>
            <div class="col-md-3">
                <label asp-for="TotalAmount" class="form-label">TotalAmount</label>
                <input asp-for="TotalAmount" type="number" class="form-control totalamount" readonly />
            </div>

            <div class="text-start" style="margin-top: 50px;">
                <button type="submit" class="btn btn-success" id="submitBtnACBF">Save</button>
                <a asp-controller="CarBooking" asp-action="CarBookingList" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
    <div id="carDetailsContainer" class="mt-4"></div>

</div>
